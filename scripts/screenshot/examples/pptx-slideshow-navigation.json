{
  "schema_version": "1",
  "name": "pptx-slideshow-navigation",
  "fixture": {
    "settings": {
      "theme": "light",
      "locale": "en",
      "explorer_visible": true,
      "linter_enabled": false,
      "auto_refresh": false
    },
    "workspace_files": [
      { "name": "baseline.md", "content": "# Baseline" },
      {
        "name": "representative.pptx",
        "source": "scripts/screenshot/fixtures/v0-22-38-multi-format/representative.pptx"
      }
    ]
  },
  "steps": [
    { "type": "launch", "viewport": { "width": 1280, "height": 900 }, "wait_seconds": 0.0 },
    {
      "type": "open_file",
      "file_name": "baseline.md",
      "wait_seconds": 0.0
    },
    {
      "type": "open_file",
      "file_name": "representative.pptx",
      "wait_seconds": 15.0,
      "wait_for_document_frame": true,
      "max_first_frame_seconds": 15.0,
      "expected_document_format": "pptx",
      "expected_document_item_count": 2,
      "expected_document_node_kind": "Page"
    },
    {
      "type": "assert_document_frame",
      "format": "pptx",
      "item_count": 2,
      "node_kind": "Page",
      "active_index": 0
    },
    { "type": "action", "action": { "toggle_slideshow": {} } },
    { "type": "action", "action": { "press_key": { "key": "ArrowRight", "wait_seconds": 0.0 } } },
    {
      "type": "assert_document_frame",
      "format": "pptx",
      "item_count": 2,
      "node_kind": "Page",
      "active_index": 1
    },
    { "type": "action", "action": { "press_key": { "key": "Home", "wait_seconds": 0.0 } } },
    {
      "type": "assert_document_frame",
      "format": "pptx",
      "item_count": 2,
      "node_kind": "Page",
      "active_index": 0
    },
    { "type": "action", "action": { "press_key": { "key": "End", "wait_seconds": 0.0 } } },
    {
      "type": "assert_document_frame",
      "format": "pptx",
      "item_count": 2,
      "node_kind": "Page",
      "active_index": 1
    },
    { "type": "action", "action": { "press_key": { "key": "Escape", "wait_seconds": 0.0 } } },
    { "type": "action", "action": { "select_next_tab": {} } },
    { "type": "assert_active_document", "path_contains": "baseline.md" },
    { "type": "quit" }
  ]
}
